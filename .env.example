# ──────────────────────────────────────────────────────────────
# Yonder Graph — Environment Configuration Template
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────

APP_NAME="Yonder Graph"
ENV="development"

# ── Pluggable LLM Configuration ──
# Supported: poolside | gemini | openai | azure | anthropic | ollama | vllm | local
LLM_PROVIDER="poolside"
LLM_MODEL_NAME="poolside/laguna-s-2.1"
POOLSIDE_API_KEY=your_poolside_api_key_here
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1

# ── Alternative LLM Provider Keys ──
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
GENERIC_LLM_API_KEY=""
GENERIC_LLM_BASE_URL=""

# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ── PostgreSQL (Audit Store) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yonder_graph_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_SCHEMA=public

# ── Target Database Metadata ──
TARGET_DB_TYPE="Oracle Database 19c/21c (Blue Yonder WMS)"

# ── Networking & Ingestion ──
PORT_BACKEND=8000
PORT_FRONTEND=3000
POLL_INTERVAL_SECONDS=60
AUTO_INGEST_CONFIDENCE_THRESHOLD=90.0
MAX_QUERY_ROW_LIMIT=100
